# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY
# Server only — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# SEO / measurement (all optional until you launch)
# Production origin, https only. Required for robots.txt to allow crawling and for the sitemap to list URLs.
NEXT_PUBLIC_SITE_URL=
# Set to false to keep a production-like staging site out of search.
NEXT_PUBLIC_ALLOW_INDEXING=true
# Search Console HTML-tag verification token (content value only).
NEXT_PUBLIC_GSC_VERIFICATION=
# GA4 measurement ID (G-XXXXXXXXXX). Analytics loads only after the visitor accepts.
NEXT_PUBLIC_GA_ID=

# Official brand profiles, comma-separated (Instagram, Facebook, TikTok, ...). Helps Google build the brand panel.
NEXT_PUBLIC_SOCIAL_URLS=
